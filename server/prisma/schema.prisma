generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String?
  apellido  String?
  telefono  String?
  rol       String   @default("cliente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos   Pedido[]
}

model Archivo {
  id        Int      @id @default(autoincrement())
  clave     String   @unique
  nombre    String
  mime      String
  datos     Bytes
  createdAt DateTime @default(now())
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String
  slug      String     @unique
  productos Producto[]
}

model Producto {
  id           Int        @id @default(autoincrement())
  nombre       String
  descripcion  String?    @db.Text
  precio       Float
  activo       Boolean    @default(true)
  imagenUrl    String?    @db.LongText
  disenoUrl    String?    @db.LongText
  disenoConfig Json?
  talles       Json?
  categoriaId  Int?
  categoria    Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Pedido {
  id                  Int      @id @default(autoincrement())
  codigo              String   @unique
  accesoToken         String?  @unique
  usuarioId           Int?
  usuario             Usuario? @relation(fields: [usuarioId], references: [id])
  estado              String   @default("pendiente")
  total               Float
  metodoPago          String   @default("mercadopago")
  clienteNombre       String
  clienteEmail        String
  clienteTelefono     String?
  direccion           String?  @db.VarChar(500)
  ciudad              String?
  provincia           String?
  codigoPostal        String?
  notas               String?  @db.Text
  mpPreferenceId      String?
  mpPaymentId         String?
  emailClienteEnviado Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  items               PedidoItem[]
}

model PedidoItem {
  id         Int     @id @default(autoincrement())
  pedidoId   Int
  pedido     Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId String?
  nombre     String
  prenda     String?
  talle      String?
  color      String?
  cantidad   Int     @default(1)
  precio     Float
  logoUrl    String? @db.Text
}
